---
import { listAssessments, listCourses } from "../lib/db";
import "../styles.css";

const courses = listCourses();
const assessments = listAssessments();
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ANU assessment planner</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Planner</a>
      <a href="/readme/">About</a>
    </nav>
    <main>
      <h1>Assessment planner</h1>
      <p class="lede">
        Keep every assessment from your ANU courses in one place, sorted by
        what's due next.
      </p>

      <section class="panel" aria-labelledby="add-heading">
        <h2 id="add-heading">Add an assessment</h2>
        <form class="assessment-form" method="post" action="/api/assessments">
          <div class="field field--course">
            <label for="course">Course</label>
            <select id="course" name="courseId" required>
              {courses.map((course) => (
                <option value={course.id}>
                  {course.code} — {course.name}
                </option>
              ))}
            </select>
          </div>

          <div class="field field--title">
            <label for="title">Title</label>
            <input id="title" name="title" required maxlength="200" placeholder="e.g. Assignment 2" />
          </div>

          <div class="field">
            <label for="dueDate">Due date</label>
            <input id="dueDate" name="dueDate" type="date" required />
          </div>

          <div class="field">
            <label for="weight">Weight (%)</label>
            <input id="weight" name="weight" type="number" min="0" max="100" step="0.1" required />
          </div>

          <button type="submit" class="assessment-form__submit">Add assessment</button>
        </form>
      </section>

      <section aria-labelledby="upcoming-heading">
        <h2 id="upcoming-heading">Upcoming assessments</h2>
        {
          assessments.length === 0 ? (
            <p class="empty-state">Nothing here yet — add your first assessment above.</p>
          ) : (
            <ul class="assessment-list">
              {assessments.map((assessment) => (
                <li class="assessment-card">
                  <div class="assessment-card__main">
                    <p class="assessment-card__course">{assessment.courseCode}</p>
                    <h3 class="assessment-card__title">{assessment.title}</h3>
                  </div>
                  <dl class="assessment-card__meta">
                    <div>
                      <dt>Due</dt>
                      <dd><time datetime={assessment.dueDate}>{assessment.dueDate}</time></dd>
                    </div>
                    <div>
                      <dt>Weight</dt>
                      <dd>{assessment.weight}%</dd>
                    </div>
                  </dl>
                </li>
              ))}
            </ul>
          )
        }
      </section>
    </main>
  </body>
</html>
