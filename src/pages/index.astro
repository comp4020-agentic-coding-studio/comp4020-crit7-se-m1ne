---
import { listAssessments, listCourses } from "../lib/db";
import "../styles.css";

const courses = listCourses();
const assessments = listAssessments();
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ANU assessment planner</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Planner</a>
      <a href="/readme/">About</a>
    </nav>
    <main>
      <h1>Assessment planner</h1>
      <p>
        One place to keep track of the assessments spread across your ANU
        course pages. Add one below; it's saved to SQLite and stays there
        across a reload.
      </p>

      <h2>Add an assessment</h2>
      <form method="post" action="/api/assessments">
        <label for="course">Course</label>
        <select id="course" name="courseId" required>
          {courses.map((course) => (
            <option value={course.id}>
              {course.code} — {course.name}
            </option>
          ))}
        </select>

        <label for="title">Title</label>
        <input id="title" name="title" required maxlength="200" />

        <label for="dueDate">Due date</label>
        <input id="dueDate" name="dueDate" type="date" required />

        <label for="weight">Weight (%)</label>
        <input id="weight" name="weight" type="number" min="0" max="100" step="0.1" required />

        <button>Add assessment</button>
      </form>

      <h2>Upcoming assessments</h2>
      {
        assessments.length === 0 ? (
          <p>No assessments yet.</p>
        ) : (
          <table>
            <caption>Ordered by due date</caption>
            <thead>
              <tr>
                <th scope="col">Course</th>
                <th scope="col">Assessment</th>
                <th scope="col">Due date</th>
                <th scope="col">Weight</th>
              </tr>
            </thead>
            <tbody>
              {assessments.map((assessment) => (
                <tr>
                  <td>{assessment.courseCode}</td>
                  <td>{assessment.title}</td>
                  <td>{assessment.dueDate}</td>
                  <td>{assessment.weight}%</td>
                </tr>
              ))}
            </tbody>
          </table>
        )
      }
    </main>
  </body>
</html>
